# Maintainer: newdee <kian@anureka.com>
pkgname=magpie-bin
_pkgname=magpie
pkgver=0.1.13
pkgrel=1
pkgdesc="Spotlight-style local launcher: search GitHub stars, files, images, bookmarks, history, clipboard, and apps"
arch=('x86_64')
url="https://github.com/newdee/magpie"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3')
provides=('magpie')
conflicts=('magpie')
options=('!strip')
source=("${_pkgname}-${pkgver}.deb::https://github.com/newdee/magpie/releases/download/v${pkgver}/magpie_${pkgver}_amd64.deb")
sha256sums=('3e4a53f59867d251d88ca99d1f050b7337b775eea2247f0502cb9857a67365c4')

package() {
    cd "${srcdir}"
    # the Tauri .deb is an ar archive; unpack its data payload into pkgdir
    # (it already lays out /usr/bin, /usr/share/applications, icons, …)
    ar x "${_pkgname}-${pkgver}.deb"
    tar -xf data.tar.* -C "${pkgdir}"
    install -Dm644 "${pkgdir}/usr/share/doc/${_pkgname}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}
